# PaleoRAG Frontend Environment Variables

# Backend API Base URL (leave empty for local dev proxying /api, or set to your deployed backend URL on Vercel)
# e.g. VITE_API_URL=https://api.paleorag.example.com
VITE_API_URL=

# Default Bearer token for protected API routes (optional, can also be configured in UI Diagnostics)
VITE_API_BEARER_TOKEN=sk-paleorag-8f2c9a1e
