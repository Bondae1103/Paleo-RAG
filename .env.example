# Copy this file to .env and fill in real values before running docker-compose up.
# Variable names here match backend/config.py's Settings fields exactly
# (case-insensitive matching via pydantic-settings).

# --- API ---
API_BEARER_TOKEN=changeme-generate-a-real-secret
API_HOST=0.0.0.0
API_PORT=8000

# --- Redis / Celery (docker-compose overrides these to container hostnames
# automatically; only edit if running services outside Docker) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=paleo_chunks
QDRANT_USE_LOCAL_MODE=false
QDRANT_LOCAL_PATH=./data/qdrant_storage

# --- Embeddings ---
# Swappable per Phase 3 — change this to benchmark alternatives (see eval/run_eval.py)
EMBEDDING_MODEL_NAME=NeuML/pubmedbert-base-embeddings
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# --- Sparse retrieval ---
# "rank_bm25" is the default (see DECISIONS.md for why over Qdrant-native sparse vectors)
SPARSE_RETRIEVAL_BACKEND=rank_bm25

# --- Reranking (optional stretch goal, off by default) ---
RERANKER_ENABLED=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- LLM ---
# "ollama" | "anthropic" | "mock" (mock is for local dev/testing only)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Taxonomy resolution ---
GBIF_API_BASE=https://api.gbif.org/v1
PBDB_API_BASE=https://paleobiodb.org/data1.2
TAXONOMY_CACHE_TTL_SECONDS=2592000

# --- Ingestion sources ---
PMC_OA_SERVICE_BASE=https://www.ncbi.nlm.nih.gov/pmc/utils/oa/oa.fcgi
BIORXIV_API_BASE=https://api.biorxiv.org

# --- Biological Database APIs ---
NCBI_EUTILS_BASE=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
NCBI_API_KEY=
NCBI_EMAIL=paleorag@example.edu
ENA_API_BASE=https://www.ebi.ac.uk/ena/portal/api
UNIPROT_API_BASE=https://rest.uniprot.org
RCSB_API_BASE=https://data.rcsb.org/rest/v1
INTERPRO_API_BASE=https://www.ebi.ac.uk/interpro/api
PROSITE_API_BASE=https://prosite.expasy.org
STRING_API_BASE=https://string-db.org/api
BIOGRID_API_BASE=https://webservice.thebiogrid.org
BIOGRID_API_KEY=
KEGG_API_BASE=https://rest.kegg.jp
ENSEMBL_API_BASE=https://rest.ensembl.org
BIO_CACHE_DIR=./data/bio_cache
BIO_CACHE_TTL_SECONDS=604800

# --- Chunking ---
CHUNK_TARGET_TOKENS=512
CHUNK_OVERLAP_TOKENS=50
CHUNK_HARD_CAP_TOKENS=1024

# --- Retrieval ---
RETRIEVAL_TOP_K=8

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
